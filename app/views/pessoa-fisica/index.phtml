<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pessoas Físicas</h1>
    <a href="<?php echo $this->url->get('pessoa-fisica/novo'); ?>" class="btn btn-primary">
        Nova Pessoa
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Data de Nascimento</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th style="width: 150px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <?php if (count($pessoas) === 0): ?>
                        <tr>
                            <td colspan="7" class="text-center">Nenhuma pessoa física cadastrada.</td>
                        </tr>
                    <?php else: ?>
                        <?php foreach ($pessoas as $pessoa): ?>
                            <tr>
                                <td><?php echo $pessoa->id; ?></td>
                                <td><?php echo $this->escaper->escapeHtml($pessoa->nome); ?></td>
                                <td><?php echo $this->escaper->escapeHtml($pessoa->cpf); ?></td>
                                <td>
                                    <?php
                                        echo $pessoa->data_nascimento
                                            ? date('d/m/Y', strtotime($pessoa->data_nascimento))
                                            : '-';
                                    ?>
                                </td>
                                <td><?php echo $pessoa->email ? $this->escaper->escapeHtml($pessoa->email) : '-'; ?></td>
                                <td><?php echo $pessoa->telefone ? $this->escaper->escapeHtml($pessoa->telefone) : '-'; ?></td>
                                <td>
                                    <a href="<?php echo $this->url->get('pessoa-fisica/editar/' . $pessoa->id); ?>" class="btn btn-sm btn-warning">
                                        Editar
                                    </a>
                                    <a href="<?php echo $this->url->get('pessoa-fisica/excluir/' . $pessoa->id); ?>" 
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Tem certeza que deseja excluir?');">
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
