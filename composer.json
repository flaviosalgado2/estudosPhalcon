{
    "name": "estudos/phalcon-crud",
    "description": "CRUD de Pessoa Física com Phalcon, migrations e Pest",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phalcon/devtools": "^5.0",
        "phalcon/ide-stubs": "^5.0",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
